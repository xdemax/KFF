# Maintainer: xdemax
# Сборка последней версии из git (ветка по умолчанию). Использование:
#   cd packaging/arch/git && makepkg -si
pkgname=karabas-flasher-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="Firmware and core flasher for Karabas Go boards (Qt 6)"
arch=('x86_64' 'aarch64')
url="https://github.com/xdemax/kgff"
license=('MIT')
depends=('qt6-base' 'qt6-serialport' 'udisks2' 'glib2' 'ca-certificates')
makedepends=('cmake' 'git')
optdepends=('polkit: install the serial port access rule from the application (pkexec)'
            'qt6-wayland: native Wayland support')
provides=('karabas-flasher')
conflicts=('karabas-flasher')
source=("kgff::git+https://github.com/xdemax/kgff.git")
sha256sums=('SKIP')

pkgver() {
  cd kgff
  ( set -o pipefail
    git describe --long --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cmake -B build -S kgff -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 kgff/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
