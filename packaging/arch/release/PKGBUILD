# Maintainer: xdemax
# Сборка выпущенной версии (по тегу vX.Y.Z на GitHub). Использование:
#   cd packaging/arch/release && updpkgsums && makepkg -si
# pkgver должен совпадать с версией в CMakeLists.txt и с тегом (v$pkgver).
pkgname=karabas-flasher
pkgver=1.0.0
pkgrel=1
pkgdesc="Firmware and core flasher for Karabas Go boards (Qt 6)"
arch=('x86_64' 'aarch64')
url="https://github.com/xdemax/kgff"
license=('MIT')
depends=('qt6-base' 'qt6-serialport' 'udisks2' 'glib2' 'ca-certificates')
makedepends=('cmake')
optdepends=('polkit: install the serial port access rule from the application (pkexec)'
            'qt6-wayland: native Wayland support')
source=("$pkgname-$pkgver.tar.gz::https://github.com/xdemax/kgff/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # заменить на реальную сумму: updpkgsums

build() {
  cmake -B build -S "kgff-$pkgver" -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "kgff-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
