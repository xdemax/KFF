	#!/bin/sh
	# Не используем `set -e`: сбой udevadm не должен ломать установку,
	# особенно в песочнице PackageKit/Discover.
	# Применить правило доступа к порту Карабаса (70-karabas.rules) без перезагрузки.
	if [ "$1" = "configure" ] && command -v udevadm >/dev/null 2>&1; then
	    timeout 10 udevadm control --reload >/dev/null 2>&1 || true
	    timeout 10 udevadm trigger --subsystem-match=tty --action=change >/dev/null 2>&1 || true
	fi
	exit 0
